{
  "name": "dsh-plugin-yushe",
  "version": "0.37.0",
  "repository": { "type": "git", "url": "git+https://github.com/yuna78/dsh-plugin-yushe.git" },
  "homepage": "https://github.com/yuna78/dsh-plugin-yushe#readme",
  "bugs": "https://github.com/yuna78/dsh-plugin-yushe/issues",
  "author": "Yuna",
  "keywords": ["大肥鱼", "鱼社", "dsh", "dsh-plugin", "deepseek-harness", "ai-pet", "bilibili", "game"],
  "description": "鱼社 · 大肥鱼虚拟养成系统：点几下就能养一条自己的大肥鱼。可视化引导一键上手，她陪你聊天、替你干活、自己去 B站学习长大，每天写日记汇报，还会写信、拍照片回来给你看",
  "icon": "./icon.webp",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "NOTICE",
    "README.md",
    "cordis.patch.yml",
    "icon.webp",
    "locale/*.json",
    "game/",
    "lib/client.js",
    "lib/index.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "license": "MIT"
}
